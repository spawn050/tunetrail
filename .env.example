# Required for Spotify authorization. Copy this file to .env and fill in your Client ID.
TUNETRAIL_SPOTIFY_CLIENT_ID=

# Optional: this is the default redirect URI registered in the Spotify Developer Dashboard.
# TUNETRAIL_SPOTIFY_REDIRECT_URI=http://127.0.0.1:8765/callback

# Optional: enable Phase 3 natural-language parsing through OpenRouter.
# The key is secret; keep .env untracked. TuneTrail requests no-data-collection routing by default.
# TUNETRAIL_OPENROUTER_API_KEY=
# TUNETRAIL_LLM_MODEL=openai/gpt-4.1-mini
# TUNETRAIL_LLM_TEMPERATURE=0
# TUNETRAIL_LLM_MAX_RETRIES=2
# TUNETRAIL_LLM_ALLOW_DATA_COLLECTION=false

# Optional: enable Last.fm enrichment. Both values are required; no Last.fm session is stored.
# TUNETRAIL_LASTFM_API_KEY=
# TUNETRAIL_LASTFM_USERNAME=

# Optional: enable cache-first MusicBrainz metadata lookups (disabled by default).
# TUNETRAIL_MUSICBRAINZ_ENABLED=true
